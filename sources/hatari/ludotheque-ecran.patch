 static bool bUseSdlRenderer;            /* true when using SDL2 renderer */
 static bool bIsSoftwareRenderer;
 
+/* ---------------------------------------------------------------------
+ * Ludothèque ST : filtres d'affichage, réglés par variables d'environnement
+ *   HATARI_LUDO_FILTRE = net | lisse | entier   (absent : comportement Hatari)
+ *       net    : pixels nets, agrandis à un multiple entier puis lissés
+ *                au plus juste (« sharp bilinear »)
+ *       lisse  : filtrage linéaire
+ *       entier : agrandissement entier seulement (bandes noires autour)
+ *   HATARI_LUDO_LIGNES = 0..100   intensité des lignes de balayage (CRT)
+ *   HATARI_LUDO_43     = 1        proportions d'un écran 4:3 (plein écran)
+ * --------------------------------------------------------------------- */
+static int ludoFiltre = -1;	/* -1 non lu, 0 Hatari, 1 net, 2 lisse, 3 entier */
+static int ludoLignes;
+static bool ludo43;
+static SDL_Texture *ludoCible;
+static int ludoK, ludoW, ludoH;
+
+static void Ludo_Lire(void)
+{
+	const char *f, *l, *a;
+	if (ludoFiltre >= 0)
+		return;
+	f = getenv("HATARI_LUDO_FILTRE");
+	l = getenv("HATARI_LUDO_LIGNES");
+	a = getenv("HATARI_LUDO_43");
+	ludoFiltre = 0;
+	if (f && !strcmp(f, "net"))
+		ludoFiltre = 1;
+	else if (f && !strcmp(f, "lisse"))
+		ludoFiltre = 2;
+	else if (f && !strcmp(f, "entier"))
+		ludoFiltre = 3;
+	ludoLignes = l ? atoi(l) : 0;
+	if (ludoLignes < 0)
+		ludoLignes = 0;
+	if (ludoLignes > 100)
+		ludoLignes = 100;
+	ludo43 = a && *a == '1';
+}
+
+static void Ludo_Liberer(void)
+{
+	if (ludoCible)
+	{
+		SDL_DestroyTexture(ludoCible);
+		ludoCible = NULL;
+	}
+}
+
+/* Rendu via une texture cible agrandie k fois (pixels nets), avec les
+ * lignes de balayage dessinées dedans, puis réduite en lissant vers la
+ * fenêtre. Retourne false si le rendu normal de Hatari doit être fait. */
+static bool Ludo_Rendu(SDL_Surface *screen)
+{
+	static SDL_Rect *rects;
+	static int nrects;
+	int w = screen->w, h = screen->h, ow = 0, oh = 0, k;
+
+	Ludo_Lire();
+	if (!(ludoFiltre == 1 || ludoLignes > 0) || !SDL_RenderTargetSupported(sdlRenderer))
+		return false;
+	SDL_GetRendererOutputSize(sdlRenderer, &ow, &oh);
+	k = (int)ceilf(fmaxf((float)ow / w, (float)oh / h));
+	if (k < 1)
+		k = 1;
+	if (k > 6)
+		k = 6;
+	if (!ludoCible || k != ludoK || w != ludoW || h != ludoH)
+	{
+		Ludo_Liberer();
+		SDL_SetHintWithPriority(SDL_HINT_RENDER_SCALE_QUALITY, "1", SDL_HINT_OVERRIDE);
+		ludoCible = SDL_CreateTexture(sdlRenderer, SDL_PIXELFORMAT_RGB888,
+		                              SDL_TEXTUREACCESS_TARGET, w * k, h * k);
+		if (!ludoCible)
+		{
+			ludoFiltre = 0;
+			ludoLignes = 0;
+			return false;
+		}
+		ludoK = k; ludoW = w; ludoH = h;
+	}
+	SDL_SetRenderTarget(sdlRenderer, ludoCible);
+	SDL_RenderCopy(sdlRenderer, sdlTexture, NULL, NULL);
+	if (ludoLignes > 0 && !bUseHighRes)
+	{
+		int r = nScreenZoomY > 0 ? nScreenZoomY : 1;	/* lignes de surface par ligne ST */
+		int p = r * k, e = p >= 3 ? (p + 1) / 3 : 1, n = (h * k) / p, i;
+		Uint8 alpha = (Uint8)(ludoLignes * 255 / 100);
+		if (n > nrects)
+		{
+			free(rects);
+			rects = malloc(n * sizeof(SDL_Rect));
+			nrects = rects ? n : 0;
+		}
+		if (rects && p >= 2)
+		{
+			SDL_SetRenderDrawBlendMode(sdlRenderer, SDL_BLENDMODE_BLEND);
+			for (i = 0; i < n; i++)
+			{
+				rects[i].x = 0; rects[i].w = w * k;
+				rects[i].y = i * p + p - e; rects[i].h = e;
+			}
+			SDL_SetRenderDrawColor(sdlRenderer, 0, 0, 0, alpha);
+			SDL_RenderFillRects(sdlRenderer, rects, n);
+			if (p >= 5)	/* bord adouci au-dessus de la ligne sombre */
+			{
+				for (i = 0; i < n; i++)
+				{
+					rects[i].y = i * p + p - e - 1; rects[i].h = 1;
+				}
+				SDL_SetRenderDrawColor(sdlRenderer, 0, 0, 0, alpha / 2);
+				SDL_RenderFillRects(sdlRenderer, rects, n);
+			}
+			SDL_SetRenderDrawBlendMode(sdlRenderer, SDL_BLENDMODE_NONE);
+			SDL_SetRenderDrawColor(sdlRenderer, 0, 0, 0, 255);
+		}
+	}
+	SDL_SetRenderTarget(sdlRenderer, NULL);
+	SDL_RenderClear(sdlRenderer);
+	SDL_RenderCopy(sdlRenderer, ludoCible, NULL, NULL);
+	SDL_RenderPresent(sdlRenderer);
+	return true;
+}
+
