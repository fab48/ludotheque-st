+/* Ludothèque ST : HATARI_LUDO_TURBO=disque, accéléré seulement pendant les
+ * chargements :
+ *  - moteur du lecteur de disquette allumé, sauf si une musique joue
+ *    (chargement pendant une intro musicale : on la laisse à vitesse normale) ;
+ *  - ou décompactage : la couleur 0 clignote (bandes dans la bordure) alors
+ *    qu'aucune musique ne joue (une intro à rasters a presque toujours sa
+ *    musique, un décompacteur jamais).
+ * Les intros, les menus et le jeu restent à vitesse normale. Bascule sur
+ * les fronts : le raccourci d'accéléré manuel reste utilisable. */
+extern int Ludo_EcrituresYM;
+static void Main_LudoTurboDisque(void)
+{
+	static int mode = -1, calme, silence, musique;
+	static bool actif;
+	bool charge;
+
+	if (mode < 0)
+	{
+		const char *e = getenv("HATARI_LUDO_TURBO");
+		mode = e && !strcmp(e, "disque");
+	}
+	if (!mode)
+		return;
+	silence = Ludo_EcrituresYM ? 0 : silence + 1;
+	musique += Ludo_EcrituresYM ? 1 : -1;	/* images avec du son, sur ~1 s */
+	if (musique < 0)
+		musique = 0;
+	if (musique > 50)
+		musique = 50;
+	charge = (FDC_Ludo_MoteurAllume() && musique < 20)
+	         || (Ludo_EcrituresCouleur0 > 8 && silence > 25);
+	if (getenv("HATARI_LUDO_DEBUG"))
+		fprintf(stderr, "LUDO vbl=%d moteur=%d c0=%d ym=%d charge=%d ff=%d\n", nVBLCount,
+		        FDC_Ludo_MoteurAllume(), Ludo_EcrituresCouleur0, Ludo_EcrituresYM, charge,
+		        ConfigureParams.System.bFastForward);
+	Ludo_EcrituresCouleur0 = 0;
+	Ludo_EcrituresYM = 0;
+	calme = charge ? 0 : calme + 1;
+	if (charge && !actif)
+	{
+		actif = true;
+		ConfigureParams.System.bFastForward = true;
+	}
+	else if (actif && calme > 8)	/* ~0,15 s émulées sans chargement */
+	{
+		actif = false;
+		ConfigureParams.System.bFastForward = false;
+	}
+}
